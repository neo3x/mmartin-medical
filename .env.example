# ====================
# DATABASE
# ====================
DATABASE_URL="postgresql://user:password@localhost:5432/martin_medical"

# ====================
# NEXTAUTH
# ====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# ====================
# AI PROVIDERS
# ====================
# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID=""

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# LMStudio (Local)
LMSTUDIO_API_URL="http://localhost:1234/v1"

# Default AI Provider (openai | anthropic | lmstudio)
AI_PROVIDER="openai"

# ====================
# VECTOR DATABASE
# ====================
# Pinecone
PINECONE_API_KEY="..."
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX="martin-medical"

# ChromaDB (Local alternative)
CHROMA_URL="http://localhost:8000"

# ====================
# REDIS CACHE
# ====================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ====================
# STORAGE (S3 / Cloudflare R2)
# ====================
S3_ENDPOINT="https://..."
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET_NAME="martin-medical"
S3_REGION="auto"
S3_PUBLIC_URL="https://..."

# ====================
# SPEECH SERVICES
# ====================
# ElevenLabs (Optional, for better TTS)
ELEVENLABS_API_KEY="..."
ELEVENLABS_VOICE_ID="..."

# ====================
# MONITORING & ANALYTICS
# ====================
# Sentry
SENTRY_DSN="..."
SENTRY_ORG="..."
SENTRY_PROJECT="..."
SENTRY_AUTH_TOKEN="..."

# PostHog
NEXT_PUBLIC_POSTHOG_KEY="..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ====================
# APPLICATION CONFIG
# ====================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MARTIN Medical Assistant"
NEXT_PUBLIC_MAX_FILE_SIZE="10485760"  # 10MB in bytes
NEXT_PUBLIC_TECHNICAL_LEVEL_DEFAULT="moderate"

# Environment
NODE_ENV="development"  # development | production | test

# ====================
# FEATURE FLAGS
# ====================
ENABLE_VOICE_FEATURES="true"
ENABLE_PDF_INTERPRETATION="true"
ENABLE_VADEMECUM="true"
ENABLE_FAMILY_MODE="false"
ENABLE_TELEMEDICINE="false"
ENABLE_WEARABLES="false"

# ====================
# RATE LIMITING
# ====================
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_AI_CALLS="20"

# ====================
# WEBSOCKET
# ====================
WEBSOCKET_PORT="3001"
WEBSOCKET_PATH="/api/socket"

# ====================
# EMAIL (Optional for notifications)
# ====================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="..."
SMTP_PASSWORD="..."
SMTP_FROM="noreply@martin-medical.com"
