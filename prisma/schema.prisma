// Prisma Schema para MARTIN Medical Assistant Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

enum UserRole {
  PATIENT
  ADMIN
  DOCTOR
  FAMILY_MEMBER
}

enum TechnicalLevel {
  SIMPLE
  MODERATE
  TECHNICAL
  EXPERT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String
  name          String?
  image         String?
  role          UserRole  @default(PATIENT)

  // Configuración de usuario
  preferredLanguage String         @default("es")
  technicalLevel    TechnicalLevel @default(MODERATE)
  timezone          String         @default("UTC")

  // Control de cuenta
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  medicalProfile      MedicalProfile?
  chatSessions        ChatSession[]
  examResults         ExamResult[]
  vademecumQueries    VademecumQuery[]
  embeddings          Embedding[]
  accounts            Account[]
  sessions            Session[]
  notifications       Notification[]
  appointments        Appointment[]
  reminders           Reminder[]
  healthMetrics       HealthMetric[]
  symptomLogs         SymptomLog[]
  managedFamilies     FamilyGroup[]       @relation("FamilyManager")
  familyMemberships   FamilyMember[]
  auditLogs           AuditLog[]
  educationalProgress EducationalProgress[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// PERFIL MÉDICO
// ============================================

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model MedicalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Información básica
  dateOfBirth DateTime?
  gender      Gender?
  bloodType   BloodType @default(UNKNOWN)
  height      Float? // en cm
  weight      Float? // en kg

  // Condiciones médicas
  chronicConditions String[] // ["diabetes", "hipertensión"]
  allergies         String[] // ["penicilina", "polen"]
  currentMedications String[] // Medicamentos actuales

  // Historial
  surgeries     String[] // ["apendicectomía 2020"]
  familyHistory String[] // ["cáncer", "diabetes tipo 2"]

  // Estilo de vida
  smoker             Boolean @default(false)
  alcoholConsumption String? // "Nunca", "Ocasional", "Regular"
  exerciseFrequency  String? // "Sedentario", "1-2/semana", "3-5/semana"
  diet               String? // "Omnívora", "Vegetariana", "Vegana"

  // Mental health
  mentalHealthConditions  String[]
  mentalHealthMedications String[]

  // Contacto de emergencia
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================
// CHAT Y CONVERSACIONES
// ============================================

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  FUNCTION
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("Nueva conversación")

  // Configuración de la sesión
  aiProvider String @default("openai") // openai, anthropic, lmstudio
  model      String @default("gpt-4-turbo")

  // Estadísticas
  messageCount Int @default(0)
  totalTokens  Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime?

  // Relaciones
  messages Message[]

  @@index([userId])
  @@index([createdAt])
  @@index([lastMessageAt])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text

  // Audio
  audioUrl      String?
  audioDuration Float? // en segundos

  // Metadata
  metadata Json? @db.JsonB // Para guardar contexto adicional

  // Tokens (para tracking de costos)
  inputTokens  Int?
  outputTokens Int?

  // Estado
  isStreaming Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([role])
}

// ============================================
// EXÁMENES MÉDICOS
// ============================================

enum ExamType {
  BLOOD_TEST
  URINE_TEST
  IMAGING
  ELECTROCARDIOGRAM
  ULTRASOUND
  MRI
  CT_SCAN
  XRAY
  OTHER
}

model ExamResult {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tipo de examen
  type ExamType
  name String // "Hemograma completo"

  // Archivo
  fileUrl  String
  fileName String
  fileSize Int

  // Análisis
  interpretation String @db.Text
  findings       Json   @db.JsonB // Hallazgos estructurados
  recommendations String[] // Recomendaciones

  // Valores críticos
  hasCriticalValues Boolean @default(false)
  criticalValues    Json?   @db.JsonB

  // Comparación con exámenes anteriores
  comparedWithExams String[] // IDs de exámenes anteriores
  trendAnalysis     Json?    @db.JsonB

  // Metadata
  examDate   DateTime? // Fecha del examen (puede ser diferente a analyzedAt)
  analyzedAt DateTime  @default(now())
  analyzedBy String    @default("AI") // AI, Doctor, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([analyzedAt])
  @@index([examDate])
}

// ============================================
// VADEMECUM
// ============================================

enum QueryType {
  TEXT
  VOICE
  IMAGE
  SYMPTOM
}

model VademecumQuery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tipo de consulta
  queryType QueryType
  input     String    @db.Text // Texto o descripción
  imageUrl  String? // URL si es por imagen

  // Resultado
  result Json @db.JsonB

  // Info del medicamento identificado
  medicationId     String?
  medicationName   String?
  activeIngredient String?

  // Verificación de interacciones
  hasInteractions Boolean @default(false)
  interactions    Json?   @db.JsonB

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([queryType])
  @@index([createdAt])
  @@index([medicationId])
}

// Base de datos de medicamentos
model Medication {
  id String @id @default(cuid())

  // Información básica
  tradeName        String   @unique
  genericName      String?
  activeIngredient String
  category         String // Analgésico, Antibiótico, etc.
  subcategory      String?

  // Descripción
  description     String   @db.Text
  indications     String[] // Usos
  contraindications String[] // Contraindicaciones
  sideEffects     String[] // Efectos secundarios
  warnings        String[] // Advertencias especiales
  dosage          String   @db.Text
  administration  String[] // Oral, Inyectable, etc.

  // Interacciones
  interactions Json? @db.JsonB

  // Imágenes
  images String[] // URLs de imágenes del medicamento

  // Metadata
  requiresPrescription Boolean @default(true)
  isGeneric            Boolean @default(false)
  isControlled         Boolean @default(false)

  // Información adicional
  manufacturer String?
  price        Float?
  availability String?

  // Búsqueda
  searchTerms String[] // Para búsqueda

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeName])
  @@index([genericName])
  @@index([activeIngredient])
  @@index([category])
}

// ============================================
// EMBEDDINGS Y RAG
// ============================================

model Embedding {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contenido
  content String @db.Text

  // Vector (se guarda en Pinecone/ChromaDB, aquí solo referencia)
  vectorId String @unique // ID en la vector DB

  // Metadata
  metadata Json   @db.JsonB
  source   String // "chat", "exam", "profile", etc.
  sourceId String? // ID del documento fuente

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
  @@index([vectorId])
  @@index([createdAt])
}

// ============================================
// NOTIFICACIONES Y RECORDATORIOS
// ============================================

enum NotificationType {
  MEDICATION
  APPOINTMENT
  EXAM_RESULT
  HEALTH_TIP
  SYSTEM
  REMINDER
  ALERT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  priority NotificationPriority @default(MEDIUM)

  title   String
  message String @db.Text
  link    String?

  // Estado
  isRead     Boolean @default(false)
  readAt     DateTime?
  isDismissed Boolean @default(false)

  // Metadata
  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

enum ReminderFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  type        String // "medication", "appointment", "measurement"

  // Programación
  scheduledAt DateTime
  frequency   ReminderFrequency @default(ONCE)
  customCron  String? // Para frecuencias personalizadas

  // Estado
  isActive    Boolean @default(true)
  lastSentAt  DateTime?
  nextSendAt  DateTime?

  // Metadata
  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([nextSendAt])
  @@index([type])
}

// ============================================
// CITAS MÉDICAS
// ============================================

enum AppointmentType {
  DOCTOR_VISIT
  LAB_TEST
  PROCEDURE
  FOLLOWUP
  TELEMEDICINE
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   AppointmentType
  status AppointmentStatus @default(SCHEDULED)

  // Detalles
  title       String
  description String? @db.Text
  doctor      String?
  specialty   String?
  location    String?
  address     String?

  // Fecha y hora
  scheduledAt DateTime
  duration    Int? // en minutos
  endAt       DateTime?

  // Telemedicina
  meetingUrl String?
  meetingId  String?

  // Notas
  notes          String? @db.Text
  preparation    String? @db.Text // Qué llevar, preparación previa
  followupNeeded Boolean @default(false)

  // Recordatorios
  reminderSent Boolean @default(false)

  // Metadata
  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([type])
}

// ============================================
// MÉTRICAS DE SALUD
// ============================================

enum MetricType {
  WEIGHT
  HEIGHT
  BLOOD_PRESSURE
  HEART_RATE
  BLOOD_GLUCOSE
  TEMPERATURE
  OXYGEN_SATURATION
  STEPS
  SLEEP_HOURS
  WATER_INTAKE
  CALORIES
  EXERCISE_MINUTES
  CUSTOM
}

model HealthMetric {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  MetricType
  value Float
  unit  String // "kg", "cm", "bpm", "mg/dL", etc.

  // Presión arterial (caso especial)
  systolic  Int?
  diastolic Int?

  // Metadata
  notes    String? @db.Text
  source   String? // "manual", "wearable", "app"
  deviceId String?

  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([measuredAt])
}

// ============================================
// REGISTRO DE SÍNTOMAS
// ============================================

model SymptomLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symptom     String
  severity    Int // 1-5
  description String? @db.Text

  // Contexto
  triggers String[] // Factores desencadenantes
  location String? // Parte del cuerpo afectada
  duration Int? // en minutos

  // Relaciones
  relatedMedications String[]
  relatedActivities  String[]

  // Metadata
  metadata Json? @db.JsonB

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([symptom])
  @@index([occurredAt])
}

// ============================================
// MODO FAMILIAR
// ============================================

model FamilyGroup {
  id        String @id @default(cuid())
  managerId String
  manager   User   @relation("FamilyManager", fields: [managerId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Configuración
  sharedData String[] // Qué datos se comparten

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]

  @@index([managerId])
}

enum FamilyRelation {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  GRANDPARENT
  GRANDCHILD
  OTHER
}

enum AccessLevel {
  FULL
  VIEW_ONLY
  EMERGENCY_ONLY
}

model FamilyMember {
  id        String @id @default(cuid())
  groupId   String
  group     FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  relation    FamilyRelation
  accessLevel AccessLevel    @default(VIEW_ONLY)

  // Permisos
  canBookAppointments  Boolean @default(false)
  canViewMedications   Boolean @default(false)
  canViewExams         Boolean @default(false)
  canReceiveAlerts     Boolean @default(true)

  addedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ============================================
// CONTENIDO EDUCATIVO
// ============================================

enum ContentType {
  ARTICLE
  VIDEO
  INFOGRAPHIC
  PODCAST
  QUIZ
}

model EducationalContent {
  id String @id @default(cuid())

  type     ContentType
  category String // "condition", "medication", "procedure", "prevention"

  title        String
  description  String? @db.Text
  content      String  @db.Text
  url          String?
  thumbnailUrl String?

  readingTime      Int? // en minutos
  difficulty       TechnicalLevel @default(MODERATE)
  tags             String[]
  relatedTopics    String[]

  // Referencias
  sources String[] @db.Text

  // Estadísticas
  views     Int @default(0)
  likes     Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  progress EducationalProgress[]

  @@index([category])
  @@index([type])
  @@index([difficulty])
  @@index([publishedAt])
}

model EducationalProgress {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  progress   Int     @default(0) // 0-100%
  completed  Boolean @default(false)
  liked      Boolean @default(false)
  bookmarked Boolean @default(false)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([completed])
}

// ============================================
// AUDITORÍA Y LOGS
// ============================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // "user_login", "exam_uploaded", etc.
  entity   String // "User", "ExamResult", etc.
  entityId String?

  details   Json?   @db.JsonB
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ============================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value Json   @db.JsonB

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
}

// ============================================
// ANÁLISIS Y REPORTES
// ============================================

model HealthReport {
  id     String @id @default(cuid())
  userId String

  type        String // "comprehensive", "summary", "emergency"
  title       String
  content     Json   @db.JsonB
  pdfUrl      String?
  dateRange   Json?  @db.JsonB

  generatedAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([generatedAt])
}
